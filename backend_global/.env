# Global Database (Central Server ရဲ့ DB)
GLOBAL_DATABASE_URL=postgresql://postgres:123456@localhost/blood_global

# Server Mode - Global အတွက် "global" ထားပါ
SERVER_MODE=global

# JWT Security (Local နဲ့ တူညီအောင်ထားပါ)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30